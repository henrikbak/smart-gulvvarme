        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=room"
          }
        ],
        "tokens": [
          {
            "name": "temperature",
            "type": "number",
            "title": {
              "en": "Target temperature",
              "da": "Måltemperatur"
            }
          }
        ],
        "id": "target_changed_externally"
      }
    ],
