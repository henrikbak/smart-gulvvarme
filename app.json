  "flow": {
    "triggers": [
      {
        "title": {
          "en": "The room started heating",
          "da": "Rummet begyndte at varme"
        },
        "hint": {
          "en": "Triggers when the room starts calling for heat.",
          "da": "Udløses når rummet begynder at kalde på varme."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=room"
          }
        ],
        "id": "heating_started"
      },
      {
        "title": {
          "en": "The room stopped heating",
          "da": "Rummet holdt op med at varme"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=room"
          }
        ],
        "id": "heating_stopped"
