          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=room"
          }
        ],
        "tokens": [
          {
            "name": "preset",
            "type": "string",
            "title": {
              "en": "Comfort level",
              "da": "Komfortniveau"
            }
          }
