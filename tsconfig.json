{
  "extends": "@tsconfig/node16/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": ".homeybuild/",
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"]
  },
  "include": ["app.ts", "api.ts", "lib/**/*.ts", "drivers/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", ".homeybuild"]
}
